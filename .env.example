# URL of the deployed Cloudflare Worker handling the contact form.
# Without it the form shows an error state on submit (with e-mail fallback).
# Set the same value as a GitHub Actions *Variable* named PUBLIC_CONTACT_ENDPOINT.
PUBLIC_CONTACT_ENDPOINT=https://psychoterapie-zarubova-contact.<account>.workers.dev

# Cloudflare Web Analytics beacon token (cookieless, no consent banner).
# Optional: analytics only load when this is set. Get it from Cloudflare →
# Web Analytics → Add a site → JS snippet. Set as a GitHub Actions *Variable*.
PUBLIC_CF_BEACON_TOKEN=
