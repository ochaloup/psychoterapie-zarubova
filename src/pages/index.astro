---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import SectionHeading from '../components/SectionHeading.astro'
import ServiceCard from '../components/ServiceCard.astro'
import PricingTable from '../components/PricingTable.astro'
import ContactForm from '../components/ContactForm.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const services = (await getCollection('sluzby')).sort(
  (a, b) => a.data.order - b.data.order,
)

const meetingPlaces: { label: string; detail: string; href?: string }[] = [
  {
    label: 'Osobně v Pardubicích',
    detail: 'Terapeutický prostor Mýtina, Bratranců Veverkových 2717',
    href: 'https://mapy.com/s/lecozozapo',
  },
  { label: 'Online', detail: 'přes Google Meet' },
  {
    label: 'Walk & Talk',
    detail: 'v parku a přilehlé přírodě v Pardubicích',
  },
  {
    label: 'V Dobříkově u Chocně',
    detail: 'individuální terapie i lesní terapie',
  },
]
---

<BaseLayout
  title="Mgr. Barbora Zárubová — Psychoterapie a psychologické poradenství"
  description="Psychoterapie a psychologické poradenství pro ženy, rodiče a děti. Klidný a bezpečný prostor v Pardubicích, online, Walk & Talk a lesní terapie v Dobříkově u Chocně."
>
  <Hero />

  <section class="section" id="sluzby">
    <div class="container">
      <SectionHeading
        title="Co nabízím"
        lede="Tři cesty, jak můžeme spolupracovat. Vyberte tu, která vás nyní nejvíc oslovuje. Na prvním setkání můžeme váš výběr doladit."
        align="center"
      />

      <div class="services-grid">
        {services.map((service) => (
          <ServiceCard
            title={service.data.title}
            tagline={service.data.tagline}
            summary={service.data.summary}
            href={`${base}/sluzby/${service.id}`}
            icon={service.data.icon}
            available={service.data.available}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="setkani">
    <div class="container">
      <SectionHeading
        title="Můžeme se setkat"
        align="center"
      />

      <ul class="meeting-places">
        {meetingPlaces.map((place) => (
          <li>
            <strong>{place.label}</strong>
            <span>
              {place.href ? (
                <a href={place.href} target="_blank" rel="noopener noreferrer">
                  {place.detail}
                </a>
              ) : (
                place.detail
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="cenik">
    <div class="container container-narrow">
      <SectionHeading
        eyebrow="Ceník a podmínky"
        title="Ceník konzultací"
        lede="Délka a forma setkání záleží na tom, co potřebujete. Při objednání si nemusíte vybírat předem — domluvíme se na prvním setkání."
      />

      <PricingTable />

      <div class="terms-grid">
        <div>
          <h3>Způsoby platby</h3>
          <ul>
            <li>
              <strong>V hotovosti</strong> — platba přímo na místě po skončení sezení.
            </li>
            <li>
              <strong>Převodem na účet</strong> — platba předem bankovním převodem.
            </li>
            <li>
              <strong>QR kódem</strong> — rychlá platba QR kódem na konci sezení.
            </li>
          </ul>
        </div>

        <div>
          <h3>Storno podmínky</h3>
          <p>
            <strong>Rezervace termínu je závazná.</strong> Pokud potřebujete domluvený termín zrušit, prosím o&nbsp;informaci nejpozději 24&nbsp;hodin předem. Při zrušení termínu méně než 24&nbsp;hodin předem hradí klient storno poplatek ve výši 50&nbsp;% ceny.
          </p>
        </div>

        <div>
          <h3>Příspěvky od pojišťoven</h3>
          <p>
            Psychoterapii poskytuji mimo oblast zdravotnictví. V&nbsp;rámci programu <a href="https://www.czap.cz/spoluprace-zp" target="_blank" rel="noopener noreferrer"><strong>Péče o&nbsp;duševní zdraví</strong></a> lze čerpat <strong>příspěvek na psychoterapii</strong> od většiny zdravotních pojišťoven. Informace o&nbsp;výši příspěvku a podmínkách čerpání získáte u&nbsp;své zdravotní pojišťovny.
          </p>
          <p class="footnote">
            Neposkytuji zdravotní služby dle zákona č.&nbsp;372/2011 Sb. Nejsem lékař a&nbsp;neprovádím lékařskou diagnostiku ani léčbu.
          </p>
        </div>

        <div>
          <h3>Ochrana osobních údajů</h3>
          <p>
            Veškeré mnou evidované informace se řídí nařízením GDPR a&nbsp;zákonem č.&nbsp;110/2019 Sb., o&nbsp;zpracování osobních údajů. Podrobnosti najdete v&nbsp;<a href={`${base}/ochrana-osobnich-udaju`}>zásadách ochrany osobních údajů</a>.
          </p>
          <p>
            Pro zvýšení kvality mých odborných služeb je moje práce pravidelně <strong>supervidována</strong>. V&nbsp;supervizi si vyhrazuji právo diskutovat průběh terapie, klient zůstává vždy anonymní.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--contact" id="kontakt">
    <div class="container contact-grid">
      <div>
        <SectionHeading
          eyebrow="Kontakt"
          title="Jak se objednat"
          lede="Objednat se můžete jednoduše přes kontaktní formulář, telefonicky nebo e‑mailem. Ozvu se vám nazpět do 2 pracovních dnů."
        />

        <ul class="contact-list">
          <li>
            <span class="contact-label">E‑mail</span>
            <a
              href="mailto:barbora.zarubova@seznam.cz"
              target="_blank"
              rel="noopener noreferrer"
            >
              barbora.zarubova@seznam.cz
            </a>
          </li>
          <li>
            <span class="contact-label">Telefon</span>
            <a href="tel:+420608879165">+420 608 879 165</a>
          </li>
          <li>
            <span class="contact-label">Kde mě najdete</span>
            <a
              href="https://mapy.com/s/lecozozapo"
              target="_blank"
              rel="noopener noreferrer"
            >
              Terapeutický prostor Mýtina<br />
              Bratranců Veverkových 2717, Pardubice
            </a>
          </li>
        </ul>
      </div>

      <div>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .section--alt {
    background: var(--color-cream-deep);
  }

  .meeting-places {
    list-style: none;
    padding: 0;
    margin: var(--space-3) auto 0;
    max-width: var(--measure-wide);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .meeting-places li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--space-3);
    background: var(--color-cream);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
    margin: 0;
  }

  .meeting-places strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-sage-dark);
    font-weight: 500;
  }

  .meeting-places span {
    color: var(--color-mute);
    font-size: 0.95rem;
  }

  .meeting-places a {
    color: inherit;
    text-decoration: none;
  }

  .meeting-places a:hover {
    color: var(--color-terracotta-dark);
  }

  .terms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .terms-grid h3 {
    color: var(--color-sage-dark);
    margin-bottom: var(--space-2);
  }

  .terms-grid p {
    max-width: none;
    margin-bottom: var(--space-2);
  }

  .terms-grid .footnote {
    font-size: 0.88rem;
    color: var(--color-mute);
    margin-top: var(--space-2);
  }

  .terms-grid ul {
    max-width: none;
  }

  .section--contact {
    background: linear-gradient(
      180deg,
      var(--color-cream) 0%,
      var(--color-cream-deep) 100%
    );
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: var(--space-5);
    align-items: start;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
  }

  .contact-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-mute);
  }

  .contact-list a {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-sage-dark);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .contact-list a:hover {
    color: var(--color-terracotta-dark);
    border-bottom-color: var(--color-terracotta);
  }

  @media (max-width: 880px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
