---
import { getEntry, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ServiceDetail from '../../components/ServiceDetail.astro'
import photo from '../../assets/rodicovske-poradenstvi.jpeg'

const entry = await getEntry('sluzby', 'poradenstvi-pro-rodice')
if (!entry) throw new Error('Missing sluzby/poradenstvi-pro-rodice content')
const { Content } = await render(entry)
---

<BaseLayout
  title={`${entry.data.title} — ${entry.data.tagline}`}
  description={entry.data.summary}
>
  <ServiceDetail
    title={entry.data.title}
    tagline={entry.data.tagline}
    available={entry.data.available}
    image={photo}
    imageAlt="Koruny stromů prozářené sluncem"
  >
    <Content />
  </ServiceDetail>
</BaseLayout>
