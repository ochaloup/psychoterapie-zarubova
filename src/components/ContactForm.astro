---
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<div class="contact-form-wrap">
  <form class="contact-form" data-contact-form novalidate>
    <div class="field">
      <label for="cf-name">Jméno a příjmení <span aria-hidden="true">*</span></label>
      <input
        id="cf-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength="200"
        aria-describedby="cf-name-error"
      />
      <p class="error" id="cf-name-error" data-error="name" aria-live="polite"></p>
    </div>

    <div class="field">
      <label for="cf-email">E-mail <span aria-hidden="true">*</span></label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="320"
        aria-describedby="cf-email-error"
      />
      <p class="error" id="cf-email-error" data-error="email" aria-live="polite"></p>
    </div>

    <div class="field">
      <label for="cf-phone">Telefon <span class="optional">(nepovinné)</span></label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        maxlength="40"
      />
    </div>

    <div class="field">
      <label for="cf-message">Zpráva <span aria-hidden="true">*</span></label>
      <textarea
        id="cf-message"
        name="message"
        rows="6"
        required
        maxlength="5000"
        aria-describedby="cf-message-help cf-message-error"
        placeholder="Stručně mi popište, s čím byste si přáli pomoci anebo se zeptejte na cokoli, co vás zajímá…"
      ></textarea>
      <p class="error" id="cf-message-error" data-error="message" aria-live="polite"></p>
      <p class="hint" id="cf-message-help">
        Pokud mi zanecháte své telefonní číslo, ozvu se vám zpět a společně domluvíme termín.
      </p>
    </div>

    <input
      type="text"
      name="hp"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="honeypot"
    />

    <p class="consent">
      Odesláním formuláře souhlasíte se <a href={`${base}/ochrana-osobnich-udaju`}>zpracováním osobních údajů</a> za účelem sjednání konzultace.
    </p>

    <button class="btn btn-primary" type="submit" data-submit>
      <span class="submit-label">Odeslat zprávu</span>
      <span class="submit-spinner" aria-hidden="true"></span>
    </button>

    <p class="form-error" data-form-error hidden role="alert">
      Zprávu se teď nepodařilo odeslat. Napište mi prosím přímo na
      <a href="mailto:barbora.zarubova@seznam.cz" target="_blank" rel="noopener noreferrer">barbora.zarubova@seznam.cz</a>
      nebo zavolejte.
    </p>
  </form>

  <div class="contact-success" data-success hidden role="status" aria-live="polite">
    <h3>Děkuji za zprávu.</h3>
    <p>Ozvu se vám nazpět do 2&nbsp;pracovních dnů.</p>
  </div>
</div>

<style>
  .contact-form-wrap {
    background: var(--color-cream);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-sage-dark);
  }

  label .optional {
    text-transform: none;
    font-weight: 400;
    color: var(--color-mute);
    letter-spacing: 0;
  }

  label span[aria-hidden='true'] {
    color: var(--color-terracotta);
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink);
    background: var(--color-cream-deep);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    transition: border-color var(--transition-base),
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
    line-height: 1.55;
    font-family: var(--font-body);
  }

  input:focus,
  textarea:focus {
    outline: none;
    background: var(--color-cream);
    border-color: var(--color-sage);
    box-shadow: 0 0 0 3px rgba(92, 107, 78, 0.15);
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--color-terracotta);
    background: #fbf3ef;
  }

  .error {
    margin: 0;
    color: var(--color-terracotta-dark);
    font-size: 0.85rem;
    min-height: 1.2rem;
    line-height: 1.3;
  }

  .hint {
    margin: 0;
    color: var(--color-mute);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .consent {
    margin: 0;
    color: var(--color-mute);
    font-size: 0.85rem;
    line-height: 1.5;
    max-width: none;
  }

  .form-error {
    margin: 0;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-terracotta);
    background: #fbf3ef;
    color: var(--color-terracotta-dark);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .form-error a {
    color: inherit;
    font-weight: 600;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  button[type='submit'] {
    align-self: flex-start;
    min-width: 200px;
    justify-content: center;
    position: relative;
  }

  .submit-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid currentColor;
    border-right-color: transparent;
    animation: spin 800ms linear infinite;
  }

  button[type='submit'][data-loading='true'] .submit-spinner {
    display: inline-block;
  }

  button[type='submit'][data-loading='true'] .submit-label::after {
    content: '…';
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .contact-success {
    text-align: center;
    padding: var(--space-3) var(--space-2);
  }

  .contact-success h3 {
    color: var(--color-sage-dark);
    font-family: var(--font-display);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .contact-success p {
    margin: 0 auto;
    color: var(--color-mute);
    max-width: 32rem;
  }
</style>

<script>
  const ENDPOINT = import.meta.env.PUBLIC_CONTACT_ENDPOINT as string | undefined

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]')
  const successEl = document.querySelector<HTMLElement>('[data-success]')
  const formErrorEl = document.querySelector<HTMLElement>('[data-form-error]')

  if (form && submit && successEl && formErrorEl) {
    const messages: Record<string, string> = {
      name: 'Prosím vyplňte své jméno.',
      email: 'Zadejte prosím platnou e‑mailovou adresu.',
      message: 'Napište prosím krátkou zprávu.',
    }

    const setError = (field: string, msg: string) => {
      const errEl = form.querySelector<HTMLElement>(`[data-error="${field}"]`)
      const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(
        `[name="${field}"]`,
      )
      if (errEl) errEl.textContent = msg
      if (input) {
        if (msg) input.setAttribute('aria-invalid', 'true')
        else input.removeAttribute('aria-invalid')
      }
    }

    const validate = (data: FormData): Record<string, string> => {
      const errors: Record<string, string> = {}
      const name = (data.get('name') as string | null)?.trim() ?? ''
      const email = (data.get('email') as string | null)?.trim() ?? ''
      const message = (data.get('message') as string | null)?.trim() ?? ''

      if (!name || name.length > 200) errors.name = messages.name
      if (!email || email.length > 320 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))
        errors.email = messages.email
      if (!message || message.length > 5000) errors.message = messages.message

      return errors
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      const data = new FormData(form)

      ;['name', 'email', 'message'].forEach((f) => setError(f, ''))

      const hp = (data.get('hp') as string | null) ?? ''
      if (hp.length > 0) {
        form.hidden = true
        successEl.hidden = false
        return
      }

      const errors = validate(data)
      const errorFields = Object.keys(errors)
      if (errorFields.length > 0) {
        errorFields.forEach((f) => setError(f, errors[f]))
        const first = form.querySelector<HTMLElement>(`[name="${errorFields[0]}"]`)
        first?.focus()
        return
      }

      submit.dataset.loading = 'true'
      submit.disabled = true
      formErrorEl.hidden = true

      let sent = false
      if (ENDPOINT) {
        try {
          const res = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: data.get('name'),
              email: data.get('email'),
              phone: data.get('phone'),
              message: data.get('message'),
              hp: data.get('hp'),
            }),
          })
          sent = res.ok
        } catch {
          sent = false
        }
      }

      submit.dataset.loading = 'false'
      submit.disabled = false

      if (!sent) {
        formErrorEl.hidden = false
        return
      }

      form.hidden = true
      successEl.hidden = false
      successEl.scrollIntoView({ behavior: 'smooth', block: 'center' })
    })
  }
</script>
