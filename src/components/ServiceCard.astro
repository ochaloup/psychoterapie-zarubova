---
interface Props {
  title: string
  tagline: string
  summary: string
  href: string
  icon: 'leaf' | 'heart' | 'forest'
  available?: boolean
}

const { title, tagline, summary, href, icon, available = true } = Astro.props
---

<a class="service-card fade-in" href={href} aria-disabled={!available}>
  <div class={`service-icon service-icon--${icon}`} aria-hidden="true">
    {icon === 'leaf' && (
      <svg viewBox="0 0 48 48" fill="none">
        <path
          d="M40 8 C 22 8 8 22 8 40 C 26 40 40 26 40 8 Z"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
        />
        <path
          d="M8 40 L 26 22"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
      </svg>
    )}
    {icon === 'heart' && (
      <svg viewBox="0 0 48 48" fill="none">
        <path
          d="M24 39 C 10 30 6 22 10 16 C 14 10 20 12 24 18 C 28 12 34 10 38 16 C 42 22 38 30 24 39 Z"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
        />
      </svg>
    )}
    {icon === 'forest' && (
      <svg viewBox="0 0 48 48" fill="none">
        <path
          d="M14 36 L 14 26 M 14 26 L 8 26 L 14 14 L 20 26 L 14 26"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        <path
          d="M34 38 L 34 24 M 34 24 L 26 24 L 34 8 L 42 24 L 34 24"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        <path d="M4 40 L 44 40" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
      </svg>
    )}
  </div>

  <div class="service-body">
    <h3>{title}</h3>
    <p class="service-tagline">{tagline}</p>
    <p class="service-summary">{summary}</p>
  </div>

  <span class="service-cta">
    {available ? 'Více o službě' : 'Připravujeme'}
    {available && (
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3 8 H 13 M 9 4 L 13 8 L 9 12"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )}
  </span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-cream);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      background var(--transition-base);
    height: 100%;
  }

  .service-card:hover {
    border-color: var(--color-sage-soft);
    box-shadow: var(--shadow-soft);
    transform: translateY(-3px);
    text-decoration: none;
    background: #fdfaf3;
  }

  .service-icon {
    width: 48px;
    height: 48px;
    color: var(--color-sage);
  }

  .service-icon svg {
    width: 100%;
    height: 100%;
  }

  .service-body h3 {
    margin: var(--space-1) 0 0.3rem;
    font-family: var(--font-display);
    color: var(--color-sage-dark);
    font-weight: 500;
    font-size: 1.55rem;
    letter-spacing: 0.005em;
  }

  .service-tagline {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-terracotta-dark);
    margin: 0 0 var(--space-2);
    font-size: 1.05rem;
  }

  .service-summary {
    color: var(--color-ink);
    font-size: 0.97rem;
    margin: 0 0 var(--space-3);
    line-height: 1.6;
  }

  .service-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-terracotta-dark);
    font-weight: 500;
  }

  .service-cta svg {
    width: 14px;
    height: 14px;
    transition: transform var(--transition-base);
  }

  .service-card:hover .service-cta svg {
    transform: translateX(3px);
  }

  .service-card[aria-disabled='true'] {
    pointer-events: auto;
  }

  .service-card[aria-disabled='true'] .service-cta {
    color: var(--color-mute);
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
  }
</style>
