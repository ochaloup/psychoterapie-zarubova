---
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="brand-block">
      <p class="footer-name">Mgr. Barbora Zárubová</p>
      <p class="footer-sub">Psychoterapeutka, psycholožka</p>
      <p class="footer-ico">IČO: 87665565</p>
    </div>

    <div>
      <h4 class="footer-h">Kontakt</h4>
      <ul class="footer-list">
        <li>
          <a
            href="mailto:barbora.zarubova@seznam.cz"
            target="_blank"
            rel="noopener noreferrer"
          >
            barbora.zarubova@seznam.cz
          </a>
        </li>
        <li>
          <a href="tel:+420608879165">+420 608 879 165</a>
        </li>
        <li class="footer-address">
          <a
            href="https://mapy.com/s/lecozozapo"
            target="_blank"
            rel="noopener noreferrer"
          >
            Terapeutický prostor Mýtina, Bratranců Veverkových 2717, Pardubice
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="footer-h">Profesní zázemí</h4>
      <ul class="footer-list">
        <li>
          Členka{' '}
          <a href="https://czap.cz/" target="_blank" rel="noopener noreferrer">
            České asociace pro psychoterapii
          </a>
        </li>
        <li>
          Ve své praxi ctím{' '}
          <a
            href="https://czap.cz/ochrana-klientu"
            target="_blank"
            rel="noopener noreferrer"
          >
            Etický kodex ČAP
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="footer-h">Informace</h4>
      <ul class="footer-list">
        <li><a href={`${base}/pribeh`}>Můj příběh</a></li>
        <li><a href={`${base}/obchodni-podminky`}>Obchodní podmínky</a></li>
        <li><a href={`${base}/ochrana-osobnich-udaju`}>Ochrana osobních údajů</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom container">
    <p>© {year} Barbora Zárubová</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-cream-deep);
    color: var(--color-ink);
    padding-block: var(--space-6) var(--space-3);
    margin-top: var(--space-6);
    font-size: 0.95rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }

  .footer-h {
    font-family: var(--font-body);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-terracotta-dark);
    margin: 0 0 var(--space-2);
    font-weight: 600;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
    color: var(--color-sage-dark);
  }

  .footer-sub {
    color: var(--color-mute);
    font-size: 0.9rem;
    margin: 0 0 0.65rem;
  }

  .footer-ico {
    font-size: 0.85rem;
    color: var(--color-mute);
    margin: 0;
  }

  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-list li {
    margin: 0;
  }

  .footer-list a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--transition-base),
      border-color var(--transition-base);
  }

  .footer-list a:hover {
    color: var(--color-terracotta-dark);
    border-bottom-color: var(--color-terracotta);
  }

  .footer-address {
    color: var(--color-mute);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    font-size: 0.85rem;
    color: var(--color-mute);
  }

  .footer-bottom p {
    margin: 0;
  }
</style>
